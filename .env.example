VIDEO_AGENT_WORKSPACE=./video-projects
VIDEO_AGENT_CONFIG=./video-agent.config.json
VIDEO_AGENT_PLANNER=fake
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY is read only from the environment; never put it in project JSON.
VIDEO_AGENT_ASR=fake
VIDEO_AGENT_ASR_MODEL=small
VIDEO_AGENT_TTS=fake
# Use openai for hosted preset/custom voices, or kokoro for local preset voices.
# VIDEO_AGENT_TTS=openai
VIDEO_AGENT_API_TOKEN=replace-with-a-long-random-token
VIDEO_AGENT_TTS_MODEL=deterministic-voice-v1
# For VIDEO_AGENT_TTS=openai use gpt-4o-mini-tts; for kokoro use hexgrad/Kokoro-82M.
VIDEO_AGENT_ALIGNMENT=none
VIDEO_AGENT_DIARIZATION=none
# HF_TOKEN is required only for configured WhisperX diarization.
VIDEO_AGENT_PYTHON=python
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_AGENT_JOB_CONCURRENCY=2
VIDEO_AGENT_JOB_ATTEMPTS=3
VIDEO_AGENT_RETRY_MS=250
VIDEO_AGENT_MAX_UPLOAD_BYTES=5368709120
VIDEO_AGENT_MAX_INPUT_US=14400000000
VIDEO_AGENT_MAX_PREVIEW_US=600000000
VIDEO_AGENT_MAX_PROJECT_BYTES=21474836480
VIDEO_AGENT_MAX_PREVIEWS=10
