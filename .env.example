VIDEO_AGENT_WORKSPACE=./video-projects
VIDEO_AGENT_CONFIG=./video-agent.config.json
VIDEO_AGENT_PLANNER=fake
OPENAI_MODEL=gpt-5.4-mini
# OPENAI_API_KEY is read only from the environment; never put it in project JSON.

# ASR choices: fake, faster-whisper, qwen3-asr, openai.
VIDEO_AGENT_ASR=fake
VIDEO_AGENT_ASR_MODEL=small
# Local high-quality multilingual/Chinese ASR with timestamp alignment:
# VIDEO_AGENT_ASR=qwen3-asr
# VIDEO_AGENT_ASR_MODEL=Qwen/Qwen3-ASR-0.6B
# Hosted edit-safe ASR: diarized speaker segments, or whisper-1 for word timestamps.
# VIDEO_AGENT_ASR=openai
# VIDEO_AGENT_ASR_MODEL=gpt-4o-transcribe-diarize
# VIDEO_AGENT_ASR_MODEL=whisper-1

# TTS choices: fake, kokoro, qwen3-tts, openai.
VIDEO_AGENT_TTS=fake
VIDEO_AGENT_TTS_MODEL=deterministic-voice-v1
# Local preset TTS:
# VIDEO_AGENT_TTS=kokoro
# VIDEO_AGENT_TTS_MODEL=hexgrad/Kokoro-82M
# Local authorized cloning + Voice Design. Models load on demand, not at normal runtime startup:
# VIDEO_AGENT_TTS=qwen3-tts
# VIDEO_AGENT_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
# Hosted preset/custom voices:
# VIDEO_AGENT_TTS=openai
# VIDEO_AGENT_TTS_MODEL=gpt-4o-mini-tts

VIDEO_AGENT_API_TOKEN=replace-with-a-long-random-token
VIDEO_AGENT_ALIGNMENT=none
VIDEO_AGENT_DIARIZATION=none
# HF_TOKEN is required only for configured WhisperX diarization.
VIDEO_AGENT_PYTHON=python
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_AGENT_JOB_CONCURRENCY=2
VIDEO_AGENT_JOB_ATTEMPTS=3
VIDEO_AGENT_RETRY_MS=250
VIDEO_AGENT_MAX_UPLOAD_BYTES=5368709120
VIDEO_AGENT_MAX_INPUT_US=14400000000
VIDEO_AGENT_MAX_PREVIEW_US=600000000
VIDEO_AGENT_MAX_PROJECT_BYTES=21474836480
VIDEO_AGENT_MAX_PREVIEWS=10
